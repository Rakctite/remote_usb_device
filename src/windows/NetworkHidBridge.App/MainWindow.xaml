<Window x:Class="NetworkHidBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network HID Bridge" Height="590" Width="620"
        MinHeight="540" MinWidth="560" WindowStartupLocation="CenterScreen">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Padding="12" Background="#FFF1F5F9" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="연결 상태" FontWeight="SemiBold" />
                    <TextBlock x:Name="ConnectionText" Text="연결 안 됨" FontSize="18" />
                    <TextBlock x:Name="EndpointText" Foreground="#FF475569" />
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock Text="현재 모드" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock x:Name="ModeText" Text="기본" FontSize="18" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>
        <GroupBox Grid.Row="1" Header="Pi 연결 설정" Margin="0,12,0,0">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" /><ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="IP 주소" VerticalAlignment="Center" />
                <TextBox x:Name="AddressBox" Grid.Column="1" Margin="4" />
                <TextBlock Grid.Column="2" Text="TCP 포트" VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBox x:Name="PortBox" Grid.Column="3" Margin="4" />
                <TextBlock Grid.Row="1" Text="PSK (Base64)" VerticalAlignment="Center" />
                <TextBox x:Name="PskBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="4" />
                <Button Grid.Row="1" Grid.Column="3" Margin="4" Content="새 키 생성" Click="GeneratePsk_Click" />
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="2" Header="입력 라우팅" Margin="0,12,0,0">
            <UniformGrid Columns="4" Margin="10">
                <Button Content="기본&#x0a;메인 O / 원격 X" Margin="3" Padding="5" Click="DefaultMode_Click" />
                <Button Content="원격 전용&#x0a;메인 X / 원격 O" Margin="3" Padding="5" Click="RemoteMode_Click" />
                <Button Content="공유&#x0a;메인 O / 원격 O" Margin="3" Padding="5" Click="SharedMode_Click" />
                <Button Content="전체 차단&#x0a;메인 X / 원격 X" Margin="3" Padding="5" Click="BlockMode_Click" />
            </UniformGrid>
        </GroupBox>
        <CheckBox x:Name="StartupCheckBox" Grid.Row="3" Margin="4,12,0,8"
                  Content="Windows 로그인 시 관리자 권한으로 자동 실행" />
        <GroupBox Grid.Row="4" Header="진단 로그 (입력 내용은 기록하지 않음)">
            <ListBox x:Name="DiagnosticsList" Margin="8" FontFamily="Consolas" FontSize="12" />
        </GroupBox>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock Text="단축키: 숫자패드 - 와 * 동시 입력" VerticalAlignment="Center" Margin="0,0,20,0" />
            <Button Content="다시 연결" Width="90" Margin="4" Click="Reconnect_Click" />
            <Button Content="저장 및 적용" Width="110" Margin="4" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
